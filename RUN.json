{
  "runcontract": 1,
  "services": [
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "depends_on": ["db"],
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-e", "."]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/v1/utils/health-check/",
        "expect_status": [200]
      },
      "env": {
        "DATABASE_URL": { "dev": "${service:db.url}" },
        "SECRET_KEY": { "generate": "hex" },
        "PROJECT_NAME": { "dev": "Full Stack FastAPI Project" },
        "FIRST_SUPERUSER": { "dev": "admin@example.com" }
      },
      "seed": [
        ["bash", "scripts/prestart.sh"]
      ],
      "test": [
        ["${python}", "-m", "pytest", "-q"]
      ],
      "lint": [
        ["${python}", "-m", "ruff", "check", "."]
      ],
      "typecheck": [
        ["${python}", "-m", "mypy", "app"]
      ]
    },
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "static",
      "depends_on": ["api"],
      "install": [
        ["npm", "install"]
      ],
      "build": [
        ["npm", "run", "build"]
      ],
      "serve_dir": "../backend/app/frontend",
      "env": {
        "VITE_API_URL": { "dev": "${service:api.origin}" }
      },
      "test": [
        ["npm", "test"]
      ]
    }
  ]
}
