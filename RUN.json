{
  "runcontract": 1,
  "services": [
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [["${python}", "-m", "pip", "install", "-q", "-e", "."]],
      "start": ["${python}", "-m", "uvicorn", "app.main:app", "--port", "${PORT}"],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/v1/utils/health-check/",
        "expect_status": [200]
      },
      "env": {
        "DATABASE_URL": {"dev": "${service:db.url}"},
        "SECRET_KEY": {"generate": "hex", "bytes": 32},
        "PROJECT_NAME": {
          "external": true,
          "degraded_without": "The committed .env supplies the application name, so the API still boots."
        },
        "FASTAPI_ENV": {"dev": "development"},
        "FRONTEND_HOST": {"dev": "${service:web.origin}"}
      }
    },
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [["npm", "ci", "--no-audit", "--no-fund"]],
      "build": [["npm", "run", "build"]],
      "start": ["npm", "run", "dev", "--", "--port", "${PORT}"],
      "port": 5173,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [200]
      },
      "env": {
        "VITE_API_URL": {"dev": "${service:api.origin}"}
      }
    },
    {
      "name": "root",
      "dir": ".",
      "stack": "python",
      "kind": "library",
      "install": [["${python}", "-m", "pip", "install", "-q", "-e", "."]]
    }
  ]
}
