# Copy this file to .env and adjust the values for your local setup.

FASTAPI_ENV=development
PROJECT_NAME="Full Stack FastAPI Project"

# Replace these development placeholders before deploying anywhere else.
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails (optional; without an SMTP host the product sends no mail)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=False
EMAILS_FROM_EMAIL=info@example.com

# Postgres (matches compose.yml and compose.override.yml)
POSTGRES_USER=app
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://app:changethis@localhost:5432/app
