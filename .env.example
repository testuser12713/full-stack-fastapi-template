# Copy this file to .env before starting the product.
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

# Generate a random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-hex-value

FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password

# Emails (optional: leave SMTP_HOST empty to disable email delivery)
SMTP_HOST=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# PostgreSQL (docker compose creates the database with POSTGRES_PASSWORD)
# The runner and docker compose provide DATABASE_URL when they start the
# database. The local fallback keeps role, password, host, port and database
# configurable instead of pinning one role.
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://${POSTGRES_USER:-app}:${POSTGRES_PASSWORD:-}@${POSTGRES_HOST:-localhost}:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-app}

# Origin of the Vite development server allowed to call the API
FRONTEND_HOST=http://localhost:5173
